# Jira and Trello connections are added in the Steerloom UI, never here.
# Optional HTTP(S) proxy for outbound connector requests on restricted networks.
HTTPS_PROXY=
# Addresses reached without the proxy, e.g. NO_PROXY=*.example.com. The local
# app otherwise uses the computer's own proxy exceptions.
NO_PROXY=

# Optional Trello-only proxy override. Unset reuses the installation Jira proxy.
# Use direct to bypass that proxy, only when your network permits direct access.
FLOWLENS_TRELLO_PROXY=

# Optional enterprise AI chat. Use its base URL or full chat-completions URL.
# The secret remains in the local Node process and must never be committed.
FLOWLENS_AI_ENDPOINT=
FLOWLENS_AI_MODEL=
FLOWLENS_AI_API_KEY=

# Defaults to Authorization: Bearer <key>. For an `api-key` header without a
# prefix, set FLOWLENS_AI_API_KEY_HEADER=api-key and
# FLOWLENS_AI_API_KEY_PREFIX=none.
FLOWLENS_AI_API_KEY_HEADER=Authorization
FLOWLENS_AI_API_KEY_PREFIX=Bearer

# Optional PEM file for an approved internal certificate authority. Relative
# paths are resolved from this repository. Never disable TLS verification.
FLOWLENS_AI_CA_FILE=

# Optional proxy used only for requests to the enterprise AI endpoint.
FLOWLENS_AI_PROXY=

# Optional Google sign-in (server-only; never use a VITE_ prefix).
# Create an OAuth Web application client in Google Cloud and register this exact URI.
STEERLOOM_GOOGLE_CLIENT_ID=
STEERLOOM_GOOGLE_CLIENT_SECRET=
STEERLOOM_GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/auth/google/callback
# Optional approved HTTP(S) proxy for Google token and signing-key requests.
# Example: http://localhost:3128. Unset uses a direct connection.
STEERLOOM_GOOGLE_PROXY=

# Optional Jira Cloud connection: operator-owned Atlassian OAuth 2.0 (3LO) app.
# These are separate from Google sign-in credentials and are server-only.
STEERLOOM_ATLASSIAN_CLIENT_ID=
STEERLOOM_ATLASSIAN_CLIENT_SECRET=
STEERLOOM_ATLASSIAN_REDIRECT_URI=http://127.0.0.1:5173/api/auth/atlassian/callback
# Optional OAuth-only proxy override; otherwise uses HTTPS_PROXY / HTTP_PROXY.
STEERLOOM_ATLASSIAN_PROXY=

# Supabase account test: open http://127.0.0.1:5173/?hosted=1 after setting URL/key.
# For production use npm run build:hosted, npm start, and docs/launch.md.
# See docs/hosted-pilot.md. Keep secrets server-only; never use VITE_ prefixes.
# STEERLOOM_PUBLIC_ORIGIN=https://your-app-host
STEERLOOM_SUPABASE_URL=
STEERLOOM_SUPABASE_PUBLISHABLE_KEY=
# STEERLOOM_CREDENTIAL_KEY=<64 random hexadecimal characters; keep stable>

# Optional loopback account-test origin and Supabase-only proxy.
# STEERLOOM_AUTH_ORIGIN=http://127.0.0.1:5173
# STEERLOOM_SUPABASE_PROXY=http://localhost:3128

# Server-only key for encrypted Supabase workspace connections.
STEERLOOM_SUPABASE_SECRET_KEY=
# Generate once with openssl rand -hex 32, keep stable and backed up.
# STEERLOOM_CREDENTIAL_KEY=

# Hosted-workspace Trello OAuth 2.0 confidential client (server-only).
# Register an app that doesn't use Power-Up capabilities, not a public client.
# Callback: http://127.0.0.1:5173/api/hosted/trello/callback for development.
# Read scopes: read:board:trello read:member:trello; offline_access requested by server.
STEERLOOM_TRELLO_CLIENT_ID=
STEERLOOM_TRELLO_CLIENT_SECRET=

# Production only: required encrypted session file on a persistent disk.
# Exactly one server process/instance; do not put this in the static dist directory.
# STEERLOOM_SESSION_FILE=/var/data/steerloom/sessions.enc

# Hosted only: tester feedback ("Send feedback" button) is emailed through
# Resend (https://resend.com/api-keys, a sending-only key) to this address.
# Without both, feedback goes to the server log.
STEERLOOM_RESEND_API_KEY=
STEERLOOM_FEEDBACK_TO=

# Hosted only: emails that may open the usage counts (/?hosted=1&page=usage),
# comma-separated. Defaults to STEERLOOM_FEEDBACK_TO.
STEERLOOM_ADMIN_EMAILS=

{
  "name": "steerloom",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:hosted": "npm run build && vite build --config vite.server.config.ts && npm run build:local && npm run package:local",
    "build:local": "vite build --config vite.local.config.ts",
    "start:local": "node dist-local/server.mjs --open",
    "package:local": "node scripts/package-local.mjs",
    "ai:eval": "tsx server/ai/eval/run.ts",
    "start": "node dist-server/main.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "lucide-react": "1.61.0",
    "openid-client": "^6.8.8",
    "papaparse": "5.5.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.7.0",
    "undici": "7.30.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "9.39.4",
    "@tailwindcss/vite": "4.2.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.19",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "17.3.0",
    "jsdom": "29.0.0",
    "prettier": "3.8.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
